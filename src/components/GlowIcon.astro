---
interface Props {
  variant: "focus" | "skills" | "workflow" | "process" | "theme" | "interfaces" | "pet";
  nodeId?: string;
}

const { variant, nodeId } = Astro.props;
const assets = {
  focus: "/assets/icon-focus.png",
  skills: "/assets/icon-skills.png",
  workflow: "/assets/icon-ai-workflow.png",
  process: "/assets/icon-process-ai.png",
  theme: "/assets/icon-theme-builders-exact.png",
  interfaces: "/assets/icon-interfaces.png",
  pet: "/assets/icon-pet-project.png",
};
---

<div class:list={["glow-icon", `glow-icon--${variant}`]} data-icon-drift data-glow-target data-node-id={nodeId} aria-hidden="true">
  {variant === "theme" ? (
    <picture class="glow-icon__base">
      <source media="(max-width: 640px)" srcset="/assets/icon-theme-builders-mobile-exact.png" />
      <img src={assets[variant]} alt="" width="633" height="468" />
    </picture>
  ) : (
    <img class="glow-icon__base" src={assets[variant]} alt="" width="300" height="300" />
  )}
  {variant === "theme" ? (
    <picture class="glow-icon__light">
      <source media="(max-width: 640px)" srcset="/assets/icon-theme-builders-mobile-exact.png" />
      <img src={assets[variant]} alt="" width="633" height="468" />
    </picture>
  ) : (
    <img class="glow-icon__light" src={assets[variant]} alt="" width="300" height="300" />
  )}
</div>
