---
import GlowIcon from "./GlowIcon.astro";

const metrics = [
  ["561", "экранов", "screens"],
  ["481", "заметка", "notes"],
  ["157", "сценариев", "flows"],
  ["2309", "комментариев в фигме", "Figma comments"],
  ["2", "года работы", "years of work"],
  ["201", "фича на будущее", "future features"],
  ["19", "UX интервью", "UX interviews"],
];
---

<section class="interfaces section-shell section-shell--wide" id="interfaces" data-section="interfaces" data-node-id="358:837">
  <div data-reveal="icon"><GlowIcon variant="interfaces" nodeId="358:838" /></div>
  <div class="display-heading-mask" data-reveal="heading">
    <h2 class="sr-only">Interfaces</h2>
    <picture>
      <source media="(max-width: 640px)" srcset="/assets/heading-interfaces-mobile.png" />
      <img class="display-heading display-heading--interfaces" src="/assets/heading-interfaces.png" alt="" width="652" height="42" />
    </picture>
  </div>

  <div class="interfaces-grid">
    {metrics.map(([value, ru, en], index) => (
      <article class:list={["interface-metric", "interactive-card", `interface-metric--${index + 1}`]} data-card-reveal>
        <strong>{value}</strong>
        <p><span data-locale="ru">{ru}</span><span data-locale="en" hidden>{en}</span></p>
      </article>
    ))}
  </div>
</section>
