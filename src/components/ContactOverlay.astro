---
import CloseIcon from "./CloseIcon.astro";
---
<div class="contact-overlay" id="contact-overlay" aria-hidden="true" tabindex="-1" data-contact-overlay>
  <button class="overlay-close" type="button" aria-label="Закрыть контакты" data-contact-close>
    <CloseIcon />
  </button>
  <div class="contact-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-title">
    <div class="contact-avatar" aria-hidden="true">
      <span class="contact-avatar__photo-shell"><img src="/assets/avatar.png" alt="" /></span>
      <img class="contact-avatar__ring" src="/assets/avatar-ring.svg" alt="" />
      <span class="contact-avatar__status"></span>
    </div>
    <h2 class="contact-heading" id="contact-title">
      <span class="contact-heading__outline">NICE<br />TO MEET</span>
      <span class="contact-heading__fill">YOU</span>
    </h2>
    <div class="contact-links">
      <a href="https://t.me/dmitrii_pershin" target="_blank" rel="noreferrer">
        <img src="/assets/contact-telegram.svg" alt="" width="62" height="62" />
        <span>dmitrii_pershin</span>
      </a>
      <a href="mailto:pershindmitrii@gmail.com">
        <img src="/assets/contact-email.svg" alt="" width="62" height="62" />
        <span>pershindmitrii@gmail.com</span>
      </a>
    </div>
  </div>
</div>
