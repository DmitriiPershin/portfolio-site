<button class="avatar-button" type="button" aria-label="Открыть контакты" aria-expanded="false" aria-controls="contact-overlay" data-contact-toggle>
  <img class="avatar-button__photo" src="/assets/avatar.png" alt="Dmitrii Pershin" width="120" height="120" />
  <img class="avatar-button__ring" src="/assets/avatar-ring.svg" alt="" width="120" height="120" />
  <span class="avatar-button__status" aria-hidden="true"></span>
</button>

<div class="contact-overlay" id="contact-overlay" aria-hidden="true" data-contact-overlay>
  <div class="contact-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-title">
    <h2 id="contact-title">Nice to meet you</h2>
    <p>
      <span data-locale="ru">Напишите мне — отвечу и буду рад познакомиться.</span>
      <span data-locale="en" hidden>Send me a message — I will be happy to connect.</span>
    </p>
    <div class="contact-links">
      <a href="https://t.me/dmitrii_pershin" target="_blank" rel="noreferrer">
        <img src="/assets/contact-telegram.svg" alt="" width="48" height="48" />
        <span>Telegram</span><strong>@dmitrii_pershin</strong>
      </a>
      <a href="mailto:pershindmitrii@gmail.com">
        <img src="/assets/contact-email.svg" alt="" width="48" height="48" />
        <span>Email</span><strong>pershindmitrii@gmail.com</strong>
      </a>
    </div>
    <button class="contact-close" type="button" data-contact-close>
      <span data-locale="ru">Закрыть</span><span data-locale="en" hidden>Close</span>
    </button>
  </div>
</div>
