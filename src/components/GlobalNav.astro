    <span class="language-code" aria-hidden="true">RU</span>
  </button>

  <button class="menu-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span></span><span></span><span></span>
