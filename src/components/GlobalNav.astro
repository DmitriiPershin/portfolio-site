---
const sections = [
  ["#focus", "FOCUS"],
  ["#hard-skills", "HARDSKILLS"],
  ["#soft-skills", "SOFTSKILLS"],
  ["#ai-workflow", "AI WORKFLOW"],
  ["#process-ai", "PROCESS & AI"],
  ["#theme-builders", "THEME BUILDERS"],
  ["#interfaces", "INTERFACES"],
  ["#pet-project", "PET PROJECT"],
];
---

<header class="floating-header" aria-label="Быстрая навигация">
  <button class="language-button" type="button" aria-label="Открыть выбор языка" aria-expanded="false" aria-controls="language-selector" data-language-toggle>
    <img src="/assets/control-language.svg" alt="" width="64" height="64" />
  </button>

  <p class="floating-header__role">Senior Product Designer</p>

  <button class="menu-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <img class="menu-button__desktop-icon" src="/assets/control-menu.svg" alt="" width="72" height="74" />
    <span></span><span></span><span></span>
  </button>
</header>

<div class="language-overlay" id="language-selector" aria-hidden="true" tabindex="-1" data-language-overlay>
  <button class="overlay-close" type="button" aria-label="Закрыть выбор языка" data-language-close>
    <img src="/assets/close-icon.png" alt="" width="64" height="64" />
  </button>
  <div class="language-dialog" role="dialog" aria-modal="true" aria-label="Выбор языка">
    <button class="language-choice" type="button" data-language-option="en" aria-pressed="false">ENG</button>
    <button class="language-choice" type="button" data-language-option="ru" aria-pressed="true">RUS</button>
  </div>
</div>

<div class="menu-overlay" id="site-menu" aria-hidden="true" tabindex="-1" data-menu-overlay>
  <button class="overlay-close" type="button" aria-label="Закрыть меню" data-menu-close>
    <img src="/assets/close-icon.png" alt="" width="64" height="64" />
  </button>
  <nav aria-label="Разделы портфолио">
    {sections.map(([href, label], index) => (
      <a href={href} class:list={[index === 1 && "is-current"]}>{label}</a>
    ))}
  </nav>
</div>

<button class="avatar-button" type="button" aria-label="Открыть контакты" aria-expanded="false" aria-controls="contact-overlay" data-contact-toggle>
  <span class="avatar-button__photo-shell">
    <img class="avatar-button__photo" src="/assets/avatar.png" alt="Dmitrii Pershin" width="198" height="198" />
  </span>
  <img class="avatar-button__ring" src="/assets/avatar-ring.svg" alt="" width="120" height="120" />
  <span class="avatar-button__status" aria-hidden="true"></span>
</button>

<div class="contact-overlay" id="contact-overlay" aria-hidden="true" tabindex="-1" data-contact-overlay>
  <button class="overlay-close" type="button" aria-label="Закрыть контакты" data-contact-close>
    <img src="/assets/close-icon.png" alt="" width="64" height="64" />
  </button>
  <div class="contact-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-title">
    <div class="contact-avatar" aria-hidden="true">
      <span class="contact-avatar__photo-shell"><img src="/assets/avatar.png" alt="" /></span>
      <img class="contact-avatar__ring" src="/assets/avatar-ring.svg" alt="" />
      <span class="contact-avatar__status"></span>
    </div>
    <h2 class="contact-heading" id="contact-title">
      <span class="contact-heading__outline">NICE<br />TO MEET</span>
      <span class="contact-heading__fill">YOU</span>
    </h2>
    <div class="contact-links">
      <a href="https://t.me/dmitrii_pershin" target="_blank" rel="noreferrer">
        <img src="/assets/contact-telegram.svg" alt="" width="62" height="62" />
        <span>dmitrii_pershin</span>
      </a>
      <a href="mailto:pershindmitrii@gmail.com">
        <img src="/assets/contact-email.svg" alt="" width="62" height="62" />
        <span>pershindmitrii@gmail.com</span>
      </a>
    </div>
  </div>
</div>
