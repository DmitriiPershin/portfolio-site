<header class="floating-header" aria-label="Быстрая навигация">
  <button class="language-button" type="button" aria-label="Открыть выбор языка" aria-expanded="false" aria-controls="language-selector" data-language-toggle>
    <img src="/assets/control-language.svg" alt="" width="64" height="64" />
  </button>

  <button class="menu-button" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <img class="menu-button__desktop-icon" src="/assets/control-menu.svg" alt="" width="72" height="74" />
