    <img src="/assets/close-icon.png" alt="" width="64" height="64" />
  </button>
  <div class="language-dialog" role="dialog" aria-modal="true" aria-label="Выбор языка">
    <button class="language-choice language-choice--english" type="button" data-language-option="en">
      <span class="sr-only">English</span>
      <img src="/assets/language-english-active.svg" alt="" width="574" height="41" />
    </button>
    <button class="language-choice language-choice--russian" type="button" data-language-option="ru">
      <span class="sr-only">Русский</span>
      <img class="language-choice__base" src="/assets/language-russian-outline.svg" alt="" width="579" height="42" />
      <img class="language-choice__hover" src="/assets/language-russian-hover.svg" alt="" width="577" height="41" />
    </button>
  </div>
</div>

