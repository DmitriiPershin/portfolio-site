---
import GlowIcon from "./GlowIcon.astro";

const platforms = [
  { icon: "/assets/platform-chrome.svg", title: "Google Chrome", url: "https://chromewebstore.google.com/detail/30-minute-timer-%E2%80%94-visual/jlanaofbnlecdkajoeojkdelomollkkg" },
  { icon: "/assets/platform-web.svg", title: "30mintimer.com", url: "https://www.30mintimer.com/?t=30&u=min&bg=0fe6584a-afcd-41d6-98e0-6f2c390aa519&text=You+Are+Awesome%21&icon=1&ring=female_voice&halfway=1&density=2&iconAnimation=2&display=1&animation=1" },
  { icon: "/assets/platform-openai.svg", title: "Open AI", url: "https://chatgpt.com/plugins/plugin_asdk_app_6a2420b57e388191a16f2f65fe21191c" },
];

const timerUrl = platforms[1].url;
---

<section class="pet section-shell section-shell--wide" id="pet-project" data-section="pet" data-node-id="358:892">
  <div data-reveal="icon"><GlowIcon variant="pet" nodeId="358:893" /></div>
  <div class="display-heading-mask" data-reveal="heading">
    <h2 class="sr-only">Pet Project</h2>
    <picture>
      <source media="(max-width: 640px)" srcset="/assets/heading-pet-project-mobile.png" />
      <img class="display-heading display-heading--pet" src="/assets/heading-pet-project.png" alt="" width="729" height="42" />
    </picture>
  </div>
  <p class="section-headline localized-copy pet__headline" data-reveal="copy">
    <span data-locale="ru">Запустил таймер на трёх платформах</span>
    <span data-locale="en" hidden>Launched a timer on three platforms</span>
  </p>

  <article class="pet-card" data-card-reveal>
    <a class="pet-card__visual-link interactive-card" href={timerUrl} target="_blank" rel="noreferrer" aria-label="Открыть 30 Minute Timer">
      <picture>
        <img class="pet-card__visual" src="/assets/pet-project.webp" alt="Интерфейс визуального таймера" width="985" height="554" />
      </picture>
    </a>
    <div class="pet-platforms">
      {platforms.map((platform) => (
        <a class="pet-platform interactive-card" href={platform.url} target="_blank" rel="noreferrer">
          <img src={platform.icon} alt="" width="60" height="60" />
          <span>{platform.title}</span>
        </a>
      ))}
    </div>
  </article>
</section>
