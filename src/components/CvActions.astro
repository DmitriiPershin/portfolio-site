---
interface Props {view?:string;contact:string;portfolio:string;labels:{download:string;contact:string;portfolio:string};placement?:'profile'|'experience'|'footer'}
const {view,contact,portfolio,labels,placement='profile'}=Astro.props;
const contactAction=Boolean(view)||placement==='experience';
---
<nav class:list={["cv-actions",`cv-actions--${placement}`]} aria-label={`CV ${placement} actions`}>
  {!contactAction && <button class="cv-action cv-action--filled interactive-card" type="button" aria-haspopup="dialog" data-pdf-toggle data-pdf-download>{labels.download}</button>}
  {contactAction && <a class:list={["cv-action",{"cv-action--filled interactive-card":!view}]} href={contact} data-contact-toggle={!view?'':undefined} aria-haspopup={!view?'dialog':undefined} aria-expanded={!view?'false':undefined} aria-controls={!view?'contact-overlay':undefined}>{labels.contact}</a>}
  <a class:list={["cv-action",{"interactive-card":!view}]} href={portfolio} data-portfolio-link>{labels.portfolio}</a>
</nav>
