---
import GlowIcon from "./GlowIcon.astro";
import DisplayHeading from "./DisplayHeading.astro";

const hardSkills = [
  ["Полный цикл продуктового дизайна", "Full-cycle product design"],
  ["White-label дизайн", "White-label design"],
  ["Multibrand дизайн-системы", "Multibrand design systems"],
  ["Архитектура AI-процессов", "AI process architecture"],
  ["Автоматизация дизайн процессов", "Design process automation"],
  ["Вайбкодинг", "Vibe coding"],
  ["Архитектура Figma", "Figma architecture"],
  ["Автоматизация Figma", "Figma automation"],
  ["JSON-to-Figma", "JSON to Figma"],
  ["UI/UX", "UI/UX"],
  ["AI-прототипирование", "AI prototyping"],
  ["AI-генерация графики и видео", "AI image and video generation"],
  ["Исследования с помощью AI", "AI-assisted research"],
  ["Финтех", "Fintech"],
  ["Криптовалюты", "Crypto"],
];

const softSkills = [
  ["Автономность", "Autonomy"],
  ["Погружение в контекст", "Context immersion"],
  ["Продуктовая инициативность", "Product initiative"],
  ["Постановка правильных вопросов", "Asking the right questions"],
  ["Формулирование проблемы", "Problem framing"],
  ["Видение продукта целиком", "Holistic product vision"],
  ["Ответственность за результат", "Ownership of outcomes"],
  ["Ориентация на масштабирование", "Scaling mindset"],
  ["Документирование решений", "Decision documentation"],
  ["Работа со стейкхолдерами", "Stakeholder collaboration"],
  ["Мышление: Системное, Стратегическое, Предпринимательское, Итеративное, Процессное", "Thinking: systems, strategic, entrepreneurial, iterative and process-oriented"],
  ["Быстрое освоение инструментов", "Fast tool adoption"],
  ["Дизайн-ревью", "Design reviews"],
  ["Визуальный вкус", "Visual taste"],
  ["Технологическое любопытство", "Technology curiosity"],
  ["Эксперименты", "Experimentation"],
];

const hardMobileRows = [
  [hardSkills[0]],
  [hardSkills[1]],
  [hardSkills[2]],
  [hardSkills[3]],
  [hardSkills[4]],
  [hardSkills[5], hardSkills[6]],
  [hardSkills[7], hardSkills[8]],
  [hardSkills[9], hardSkills[10]],
  [hardSkills[11]],
  [hardSkills[12], hardSkills[13]],
  [hardSkills[14]],
];

const softMobileRows = [
  [softSkills[0], softSkills[1]],
  ...softSkills.slice(2, 12).map((skill) => [skill]),
  [softSkills[12], softSkills[13]],
  ...softSkills.slice(14).map((skill) => [skill]),
];
---

<section class="skills section-shell section-shell--wide" id="hard-skills" data-section="skills" data-node-id="358:537">
  <div data-reveal="icon"><GlowIcon variant="skills" nodeId="358:538" /></div>

  <div class="skill-group" data-node-id="358:555">
    <div class="display-heading-mask" data-reveal="heading">
      <DisplayHeading text="HARDSKILLS" mobileLines={["HARD", "SKILLS"]} tone="purple" nodeId="358:556" />
    </div>
    <div class="skill-chips skill-chips--hard skill-chips--desktop" data-reveal="copy">
      {hardSkills.map(([ru, en]) => (
        <span class="skill-chip interactive-card">
          <span data-locale="ru">{ru}</span><span data-locale="en" hidden>{en}</span>
        </span>
      ))}
    </div>
    <div class="skill-chip-rows skill-chip-rows--hard skill-chip-rows--mobile" data-reveal="copy">
      {hardMobileRows.map((row) => (
        <div class="skill-chip-row">
          {row.map(([ru, en]) => (
            <span class="skill-chip interactive-card">
              <span data-locale="ru">{ru}</span><span data-locale="en" hidden>{en}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="skill-group" id="soft-skills" data-node-id="358:588">
    <div class="display-heading-mask" data-reveal="heading">
      <DisplayHeading text="SOFTSKILLS" mobileLines={["SOFT", "SKILLS"]} tone="purple" outline nodeId="358:589" />
    </div>
    <div class="skill-chips skill-chips--soft skill-chips--desktop" data-reveal="copy">
      {softSkills.map(([ru, en]) => (
        <span class:list={["skill-chip", "interactive-card", ru.startsWith("Мышление:") && "skill-chip--thinking"]}>
          <span data-locale="ru">{ru}</span><span data-locale="en" hidden>{en}</span>
        </span>
      ))}
    </div>
    <div class="skill-chip-rows skill-chip-rows--soft skill-chip-rows--mobile" data-reveal="copy">
      {softMobileRows.map((row) => (
        <div class="skill-chip-row">
          {row.map(([ru, en]) => (
            <span class:list={["skill-chip", "interactive-card", ru.startsWith("Мышление:") && "skill-chip--thinking"]}>
              <span data-locale="ru">{ru}</span><span data-locale="en" hidden>{en}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
