---
import GlowIcon from "./GlowIcon.astro";
import DisplayHeading from "./DisplayHeading.astro";
import WorkflowRoute from "./WorkflowRoute.astro";

const inputs = [
  { ru: "Референсы", en: "References", icon: "/assets/icon-references.svg", nodeId: "358:652" },
  { ru: "Пожелания", en: "Wishes", icon: "/assets/icon-wishes.svg", nodeId: "358:658" },
  { ru: "Сайт", en: "Website", icon: "/assets/icon-site.svg", nodeId: "358:665" },
  { ru: "Брендбук", en: "Brand book", icon: "/assets/icon-brandbook.svg", nodeId: "358:672" },
];

const tools = [
  { id: "claude-context", title: "Claude", icon: "/assets/workflow-frame-claude-context.svg", ru: "Контекст", en: "Context", area: "claudeContext", nodeId: "358:686" },
  { id: "magnific", title: "Magnific", icon: "/assets/workflow-frame-magnific.svg", ru: "Интерпретация контекста", en: "Context interpretation", area: "magnific", nodeId: "358:680" },
  { id: "claude-style", title: "Claude", icon: "/assets/workflow-frame-claude-style.svg", ru: "Стили", en: "Styles", area: "claudeStyle", nodeId: "358:692" },
  { id: "figma", title: "Figma", icon: "/assets/workflow-frame-figma.svg", ru: "Variables · Styles", en: "Variables · Styles", area: "figma", nodeId: "358:697" },
  { id: "designer", title: "Designer", icon: "/assets/workflow-frame-designer.svg", ru: "Template", en: "Template", area: "designer", nodeId: "358:711" },
  { id: "frontend", title: "Frontend", icon: "/assets/workflow-frame-frontend.png", ru: "Design Assets · JSON", en: "Design Assets · JSON", area: "frontend", nodeId: "358:708" },
];
---

<section class="ai-workflow section-shell section-shell--wide" id="ai-workflow" data-section="ai-workflow" data-node-id="358:631">
  <div data-reveal="icon"><GlowIcon variant="workflow" nodeId="358:632" /></div>

  <div class="section-copy ai-workflow__copy" data-node-id="358:644">
    <div class="display-heading-mask" data-reveal="heading">
      <DisplayHeading text="AI WORKFLOW" mobileLines={["AI", "WORK", "FLOW"]} tone="blue" nodeId="358:645" />
    </div>
    <p class="section-headline localized-copy" data-reveal="copy" data-node-id="358:646">
      <span data-locale="ru">Создал AI ферму по производству стилей, <br />иллюстраций, фонов и иконок</span>
      <span data-locale="en" hidden>Built an AI farm for producing styles, <br />illustrations, backgrounds and icons</span>
    </p>
  </div>

  <div class="workflow-stage" data-workflow-scene data-node-id="358:647">
    <div class="workflow-scene workflow-scene--desktop">
      <div class="workflow-routes-desktop" aria-hidden="true">
        <WorkflowRoute name="context" />
        <WorkflowRoute name="interpretation" />
        <WorkflowRoute name="styles" />
        <img class="workflow-route workflow-route--variables" src="/assets/workflow-route-variables.svg" alt="" />
        <img class="workflow-route workflow-route--template" src="/assets/workflow-route-template.svg" alt="" />
        <img class="workflow-route workflow-route--assets" src="/assets/workflow-route-assets.svg" alt="" />
        <img class="workflow-route workflow-route--files" src="/assets/workflow-route-files.svg" alt="" />
      </div>

      <div class="workflow-grid">
        <article class="workflow-context workflow-card interactive-card" data-workflow-node="context" data-node-id="358:649">
          <h3><span data-locale="ru">Контекст клиента</span><span data-locale="en" hidden>Client context</span></h3>
          <div class="workflow-inputs" data-node-id="358:651">
            {inputs.map((input) => (
              <div class="workflow-input" data-workflow-input data-node-id={input.nodeId}>
                <img src={input.icon} alt="" width="60" height="60" />
                <span data-locale="ru">{input.ru}</span><span data-locale="en" hidden>{input.en}</span>
              </div>
            ))}
          </div>
        </article>

        {tools.map((tool) => (
          <div class:list={["tool-wrap", `tool-wrap--${tool.area}`]}>
            <article class="workflow-tool workflow-card interactive-card" data-workflow-node={tool.id} data-node-id={tool.nodeId}>
              <span class="app-icon-frame interactive-card" data-glow-target>
                <img src={tool.icon} alt="" width="150" height="150" />
              </span>
              <h3>{tool.title}</h3>
            </article>
          </div>
        ))}
      </div>
    </div>

    <div class="workflow-scene workflow-scene--mobile">
      <div class="workflow-mobile-sequence">
        <article class="workflow-context workflow-card interactive-card" data-mobile-workflow-node="context">
          <h3><span data-locale="ru">Контекст клиента</span><span data-locale="en" hidden>Client context</span></h3>
          <div class="workflow-inputs">
            {inputs.map((input) => (
              <div class="workflow-input" data-mobile-workflow-input>
                <img src={input.icon} alt="" width="40" height="40" />
                <span data-locale="ru">{input.ru}</span><span data-locale="en" hidden>{input.en}</span>
              </div>
            ))}
          </div>
        </article>

        <div class="mobile-flow mobile-flow--1" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track">
            <span class="mobile-flow-label"><span data-locale="ru">Контекст</span><span data-locale="en" hidden>Context</span></span>
          </span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="claude-context">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-01.png" alt="" width="54" height="54" /></span><h3>Claude</h3>
        </article>
        <div class="mobile-flow mobile-flow--1" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track">
            <span class="mobile-flow-label"><span data-locale="ru">Интерпретация контекста</span><span data-locale="en" hidden>Context interpretation</span></span>
          </span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="magnific">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-02.png" alt="" width="54" height="54" /></span><h3>Magnific</h3>
        </article>
        <div class="mobile-flow mobile-flow--1" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track">
            <span class="mobile-flow-label"><span data-locale="ru">Стили</span><span data-locale="en" hidden>Styles</span></span>
          </span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="claude-style">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-03.png" alt="" width="54" height="54" /></span><h3>Claude</h3>
        </article>
        <div class="mobile-flow mobile-flow--2" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track"><span class="mobile-flow-label">Variables.json</span></span>
          <span class="mobile-flow__track"><span class="mobile-flow-label">Styles.json</span></span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="figma">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-04.png" alt="" width="54" height="54" /></span><h3>Figma</h3>
        </article>
        <div class="mobile-flow mobile-flow--1" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track"><span class="mobile-flow-label">Template</span></span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="designer">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-05.png" alt="" width="54" height="54" /></span><h3>Designer</h3>
        </article>
        <div class="mobile-flow mobile-flow--3" data-mobile-flow aria-hidden="true">
          <span class="mobile-flow__track"><span class="mobile-flow-label">Design Assets</span></span>
          <span class="mobile-flow__track"><span class="mobile-flow-label">Styles.json</span></span>
          <span class="mobile-flow__track"><span class="mobile-flow-label">Variables.json</span></span>
        </div>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="frontend">
          <span class="app-icon-frame interactive-card" data-glow-target><img src="/assets/workflow-mobile-06.png" alt="" width="54" height="54" /></span><h3>Frontend</h3>
        </article>
      </div>
    </div>
  </div>
</section>
