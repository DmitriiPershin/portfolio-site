---
import GlowIcon from "./GlowIcon.astro";

const inputs = [
  { ru: "Референсы", en: "References", icon: "/assets/icon-references.svg", nodeId: "358:652" },
  { ru: "Пожелания", en: "Wishes", icon: "/assets/icon-wishes.svg", nodeId: "358:658" },
  { ru: "Сайт", en: "Website", icon: "/assets/icon-site.svg", nodeId: "358:665" },
  { ru: "Брендбук", en: "Brand book", icon: "/assets/icon-brandbook.svg", nodeId: "358:672" },
];

const tools = [
  { id: "claude-context", title: "Claude", icon: "/assets/logo-claude.svg", ru: "Контекст", en: "Context", area: "claudeContext", nodeId: "358:686" },
  { id: "magnific", title: "Magnific", icon: "/assets/logo-magnific.svg", ru: "Интерпретация контекста", en: "Context interpretation", area: "magnific", nodeId: "358:680" },
  { id: "claude-style", title: "Claude", icon: "/assets/logo-claude.svg", ru: "Стили", en: "Styles", area: "claudeStyle", nodeId: "358:692" },
  { id: "figma", title: "Figma", icon: "/assets/logo-figma.svg", ru: "Variables · Styles", en: "Variables · Styles", area: "figma", nodeId: "358:697" },
  { id: "designer", title: "Designer", icon: "/assets/logo-designer.svg", ru: "Template", en: "Template", area: "designer", nodeId: "358:711" },
  { id: "frontend", title: "Frontend", icon: "/assets/logo-frontend.png", ru: "Design Assets · JSON", en: "Design Assets · JSON", area: "frontend", nodeId: "358:708" },
];
---

<section class="ai-workflow section-shell section-shell--wide" id="ai-workflow" data-section="ai-workflow" data-node-id="358:631">
  <div data-reveal="icon"><GlowIcon variant="workflow" nodeId="358:632" /></div>

  <div class="section-copy ai-workflow__copy" data-node-id="358:644">
    <div class="display-heading-mask" data-reveal="heading">
      <h2 class="sr-only">AI Workflow</h2>
      <picture>
        <source media="(max-width: 640px)" srcset="/assets/heading-ai-workflow-mobile.png" />
        <img class="display-heading display-heading--workflow" src="/assets/heading-ai-workflow.png" alt="" width="761" height="42" data-node-id="358:645" />
      </picture>
    </div>
    <p class="section-headline localized-copy" data-reveal="copy" data-node-id="358:646">
      <span data-locale="ru">Создал AI ферму по производству стилей, <br />иллюстраций, фонов и иконок</span>
      <span data-locale="en" hidden>Built an AI farm for producing styles, <br />illustrations, backgrounds and icons</span>
    </p>
  </div>

  <div class="workflow-stage" data-workflow-scene data-node-id="358:647">
    <div class="workflow-scene workflow-scene--desktop">
      <div class="workflow-connectors-desktop" aria-hidden="true">
        <img class="connector connector--top-a" src="/assets/ai-connector-top-a.svg" alt="" />
        <img class="connector connector--top-b" src="/assets/ai-connector-top-b.svg" alt="" />
        <img class="connector connector--context-down" src="/assets/ai-connector-context-down.svg" alt="" />
        <img class="connector connector--left" src="/assets/ai-connector-left.svg" alt="" />
        <img class="connector connector--center" src="/assets/ai-connector-center.svg" alt="" />
        <img class="connector connector--right" src="/assets/ai-connector-right.svg" alt="" />
        <img class="connector connector--bottom-left" src="/assets/ai-connector-bottom-left.svg" alt="" />
        <img class="connector connector--bottom" src="/assets/ai-connector-bottom.svg" alt="" />
        <span class="connector-label connector-label--context"><span data-locale="ru">Контекст</span><span data-locale="en" hidden>Context</span></span>
        <span class="connector-label connector-label--interpretation"><span data-locale="ru">Интерпретация контекста</span><span data-locale="en" hidden>Context interpretation</span></span>
        <span class="connector-label connector-label--styles"><span data-locale="ru">Стили</span><span data-locale="en" hidden>Styles</span></span>
        <span class="connector-label connector-label--tokens-a">Variables.json</span>
        <span class="connector-label connector-label--tokens-b">Styles.json</span>
        <span class="connector-label connector-label--template">Template</span>
        <span class="connector-label connector-label--assets">Design Assets</span>
        <span class="connector-label connector-label--variables-a">Variables.json</span>
        <span class="connector-label connector-label--variables-b">Styles.json</span>
      </div>

      <div class="workflow-grid">
        <article class="workflow-context workflow-card interactive-card" data-workflow-node="context" data-node-id="358:649">
          <h3><span data-locale="ru">Контекст клиента</span><span data-locale="en" hidden>Client context</span></h3>
          <div class="workflow-inputs" data-node-id="358:651">
            {inputs.map((input) => (
              <div class="workflow-input" data-workflow-input data-node-id={input.nodeId}>
                <img src={input.icon} alt="" width="60" height="60" />
                <span data-locale="ru">{input.ru}</span><span data-locale="en" hidden>{input.en}</span>
              </div>
            ))}
          </div>
        </article>

        {tools.map((tool) => (
          <div class:list={["tool-wrap", `tool-wrap--${tool.area}`]}>
            <article class="workflow-tool workflow-card interactive-card" data-workflow-node={tool.id} data-node-id={tool.nodeId}>
              <img src={tool.icon} alt="" width="150" height="150" />
              <h3>{tool.title}</h3>
            </article>
          </div>
        ))}
      </div>
    </div>

    <div class="workflow-scene workflow-scene--mobile">
      <img class="workflow-connectors-mobile" src="/assets/ai-connectors-mobile.svg" alt="" aria-hidden="true" />
      <div class="workflow-mobile-sequence">
        <article class="workflow-context workflow-card interactive-card" data-mobile-workflow-node="context">
          <h3><span data-locale="ru">Контекст клиента</span><span data-locale="en" hidden>Client context</span></h3>
          <div class="workflow-inputs">
            {inputs.map((input) => (
              <div class="workflow-input" data-mobile-workflow-input>
                <img src={input.icon} alt="" width="40" height="40" />
                <span data-locale="ru">{input.ru}</span><span data-locale="en" hidden>{input.en}</span>
              </div>
            ))}
          </div>
        </article>

        <span class="mobile-flow-label"><span data-locale="ru">Контекст</span><span data-locale="en" hidden>Context</span></span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="claude-context">
          <img src="/assets/logo-claude.svg" alt="" width="48" height="48" /><h3>Claude</h3>
        </article>
        <span class="mobile-flow-label"><span data-locale="ru">Интерпретация контекста</span><span data-locale="en" hidden>Context interpretation</span></span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="magnific">
          <img src="/assets/logo-magnific.svg" alt="" width="48" height="48" /><h3>Magnific</h3>
        </article>
        <span class="mobile-flow-label"><span data-locale="ru">Стили</span><span data-locale="en" hidden>Styles</span></span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="claude-style">
          <img src="/assets/logo-claude.svg" alt="" width="48" height="48" /><h3>Claude</h3>
        </article>
        <span class="mobile-flow-label mobile-flow-label--group"><span>Variables.json</span><span>Styles.json</span></span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="figma">
          <img src="/assets/logo-figma.svg" alt="" width="48" height="48" /><h3>Figma</h3>
        </article>
        <span class="mobile-flow-label">Template</span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="designer">
          <img src="/assets/logo-designer.svg" alt="" width="48" height="48" /><h3>Designer</h3>
        </article>
        <span class="mobile-flow-label mobile-flow-label--group"><span>Design Assets</span><span>Styles.json</span><span>Variables.json</span></span>
        <article class="workflow-tool workflow-card interactive-card" data-mobile-workflow-node="frontend">
          <img src="/assets/logo-frontend.png" alt="" width="48" height="48" /><h3>Frontend</h3>
        </article>
      </div>
    </div>
  </div>
</section>
