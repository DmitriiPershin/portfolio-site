---
import SiteHeader from "../components/SiteHeader.astro";
import AvatarButton from "../components/AvatarButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import en from "../data/cv.json";
import ru from "../data/cv-ru.json";
import pdfManifest from "../data/cv-pdf-manifest.json";
import CloseIcon from "../components/CloseIcon.astro";
import ContactOverlay from "../components/ContactOverlay.astro";
import MorphLabel from "../components/MorphLabel.astro";
const lang = Astro.url.searchParams.get("lang") === "ru" ? "ru" : "en";
const theme = Astro.url.searchParams.get("theme") === "light" ? "light" : "dark";
const viewParam = Astro.url.searchParams.get("view");
const view = viewParam === "pdf-desktop" ? "desktop" : viewParam === "pdf-mobile" ? "mobile" : undefined;
const cv = lang === "ru" ? ru : en;
const labels = lang === "ru" ? {download:"Скачать PDF ↓",portfolio:"Портфолио →",contact:"Контакт",experience:"Опыт",earlier:"Ранний опыт",focus:"Фокус",capabilities:"Навыки",independent:"Свой продукт",career:"Начало карьеры",education:"Образование",project:"Посмотреть проект →",menu:"Открыть навигацию",language:"Выбрать язык",light:"Включить светлую тему",dark:"Включить тёмную тему",close:"Закрыть",pdfTitle:"Скачать CV",pending:"Макеты PDF на согласовании. Скачивание появится после утверждения.",pdfState:`${theme === "dark" ? "Тёмная" : "Светлая"} тема · Русский`} : {download:"Download PDF ↓",portfolio:"View portfolio →",contact:"Contact",experience:"Experience",earlier:"Earlier experience",focus:"Focus",capabilities:"Capabilities",independent:"Independent product",career:"Earlier career",education:"Education",project:"View project →",menu:"Open navigation",language:"Choose language",light:"Switch to light theme",dark:"Switch to dark theme",close:"Close",pdfTitle:"Download CV",pending:"PDF layouts are under review. Downloads will be available after approval.",pdfState:`${theme === "dark" ? "Dark" : "Light"} theme · English`};
const recent = cv.experience.slice(0, 2);
const earlier = cv.experience.slice(2);
const preferenceURL = (nextLang=lang,nextTheme=theme) => `/cv?lang=${nextLang}&theme=${nextTheme}`;
const portfolio = view ? "https://portfolio-production-e2d0.up.railway.app/" : "/";
const variants = pdfManifest.variants as Record<string, {url:string}>;
const pdfURL = (layout:string) => pdfManifest.approved ? variants[`${lang}-${theme}-${layout}`]?.url : undefined;
---

<BaseLayout title="Dmitrii Pershin — CV | AI-assisted Design & DesignOps" description={cv.summary} lang={lang} cvTheme={theme} cvView={view}>
  <SiteHeader cv lang={lang} theme={theme} />
  <main class="cv-page" data-section="hero" data-node-id="584:3" data-mobile-node-id="584:4">
    <header class="cv-header" data-node-id="586:2">
      <a class="cv-wordmark" href={portfolio} data-portfolio-link aria-label="Dmitrii Pershin — portfolio" data-cv-wordmark><img src="/assets/cv-wordmark.svg" alt="Dmitrii Pershin" width="951" height="214" fetchpriority="high" data-shared-wordmark /></a>
    </header>
    <section class="cv-profile" aria-labelledby="cv-role" data-node-id="586:26">
      <h1 id="cv-role" data-node-id="586:28">{cv.role}</h1>
      <p class="cv-subtitle" data-node-id="586:27">{cv.subtitle}</p>
      <p class="cv-summary" data-node-id="586:29">{cv.summary}</p>
      <nav class="cv-actions" aria-label="CV actions">
        {!view && <button class="cv-action cv-action--filled" type="button" aria-haspopup="dialog" data-pdf-toggle data-pdf-download>{labels.download}</button>}
        {view && <a class="cv-action" href={cv.contact}>{labels.contact}</a>}
        <a class="cv-action" href={portfolio} data-portfolio-link>{labels.portfolio}</a>
      </nav>
    </section>
    <div class="cv-content" data-node-id="586:35">
      <section class="cv-experience" aria-labelledby="experience-heading" data-node-id="586:36">
        <h2 id="experience-heading">{labels.experience}</h2>
        {recent.map((entry,index) => <article class="cv-job" data-node-id={index === 0 ? "586:40" : "586:45"}><h3>{entry.title}</h3><p class="cv-job__meta">{entry.meta}</p><p class="cv-job__dates">{entry.dates}</p><ul>{entry.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}
        <h2>{labels.earlier}</h2>
        {earlier.map((entry,index) => <article class="cv-job" data-node-id={index === 0 ? "586:51" : "586:56"}><h3>{entry.title}</h3><p class="cv-job__meta">{entry.meta}</p><p class="cv-job__dates">{entry.dates}</p><ul>{entry.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}
      </section>
      <aside class="cv-practice" aria-label="Focus and background" data-node-id="586:61">
        <section id="cv-focus" data-node-id="586:62"><h2>{labels.focus}</h2><ul class="cv-lines">{cv.focus.map(line => <li>{line}</li>)}</ul></section>
        <section data-node-id="586:65"><h2>{labels.capabilities}</h2><ul class="cv-lines">{cv.capabilities.map(line => <li>{line}</li>)}</ul></section>
        <section data-node-id="586:71"><h2>{labels.independent}</h2><p class="cv-lines">{cv.independent.split("\n").map(line => <span>{line}</span>)}</p><a class="cv-action cv-project-link" href={cv.timer} target="_blank" rel="noreferrer">{labels.project}</a></section>
        <section data-node-id="590:18"><h2>{labels.career}</h2><p class="cv-lines">{cv.earlierCareer.split("\n").map(line => <span>{line}</span>)}</p></section>
        <section data-node-id="590:21"><h2>{labels.education}</h2><p class="cv-lines">{cv.education.split("\n").map(line => <span>{line}</span>)}</p></section>
      </aside>
    </div>
    <footer class="cv-footer" id="cv-contact" data-node-id="586:80"><nav class="cv-actions" aria-label="CV footer actions">
        {!view && <button class="cv-action cv-action--filled" type="button" aria-haspopup="dialog" data-pdf-toggle data-pdf-download>{labels.download}</button>}
        {view && <a class="cv-action" href={cv.contact}>{labels.contact}</a>}
        <a class="cv-action" href={portfolio} data-portfolio-link>{labels.portfolio}</a>
      </nav></footer>
  </main>
  <div class="language-overlay" id="cv-language-overlay" aria-hidden="true" tabindex="-1" data-language-overlay>
    <button class="overlay-close" type="button" aria-label={labels.close} data-language-close><CloseIcon /></button>
    <div class="language-dialog" role="dialog" aria-modal="true" aria-label={labels.language}>
      <button class="language-choice" type="button" data-language-option="en" aria-pressed={lang === "en" ? "true" : "false"}><MorphLabel text="ENG" /></button>
      <button class="language-choice" type="button" data-language-option="ru" aria-pressed={lang === "ru" ? "true" : "false"}><MorphLabel text="RUS" /></button>
    </div>
  </div>
  <div class="menu-overlay" id="cv-menu-overlay" aria-hidden="true" tabindex="-1" data-menu-overlay>
    <button class="overlay-close" type="button" aria-label={labels.close} data-menu-close><CloseIcon /></button>
    <nav aria-label="CV sections">
      <a href="#experience-heading"><MorphLabel text="EXPERIENCE" /></a><a href="#cv-focus"><MorphLabel text="FOCUS" /></a><a href="#cv-contact"><MorphLabel text="CONTACT" /></a><a href={portfolio} data-portfolio-link><MorphLabel text="PORTFOLIO" /></a>
    </nav>
  </div>
  <div class="language-overlay pdf-overlay" id="cv-pdf-dialog" aria-hidden="true" tabindex="-1" data-pdf-overlay>
    <button class="overlay-close" type="button" aria-label={labels.close} data-pdf-close><CloseIcon /></button>
    <div class="language-dialog" role="dialog" aria-modal="true" aria-label="PDF format">
      {["desktop","mobile"].map(layout => <a class="language-choice" href={pdfURL(layout)} download data-pdf-format={layout}><MorphLabel text={layout === "desktop" ? "desktop pdf" : "mobile pdf"} /></a>)}
    </div>
  </div>
  {!view && <AvatarButton />}
  <ContactOverlay />
  <noscript><p class="cv-nojs">{labels.language}: <a href={preferenceURL("en")}>English</a> · <a href={preferenceURL("ru")}>Русский</a> · <a href={pdfURL("desktop")} download>desktop pdf</a> · <a href={pdfURL("mobile")} download>mobile pdf</a></p></noscript>
  <script>import { initCvNavigation } from "../scripts/cv-navigation"; initCvNavigation(); import { initCvControls } from "../scripts/cv-controls"; initCvControls();</script>
</BaseLayout>
