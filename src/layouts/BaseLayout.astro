---
import "../styles/global.css";
import {socialMetadata, SOCIAL_IMAGE} from "../lib/social";

interface Props {
  lang?: "ru" | "en";
  cvTheme?: "dark" | "light";
  cvView?: "desktop" | "mobile";
}

const { lang = Astro.locals.language || "en", cvTheme, cvView } = Astro.props;
const social = socialMetadata(lang, Astro.url.pathname === "/cv");
---

<!doctype html>
<html lang={lang} data-cv-theme={cvTheme} data-cv-view={cvView}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={cvTheme === "light" ? "#f6f4ff" : "#000000"} />
    <meta name="description" content={social.description} />
    <link rel="canonical" href={social.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dmitrii Pershin" />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    <meta property="og:url" content={social.url} />
    <meta property="og:locale" content={social.locale} />
    <meta property="og:locale:alternate" content={social.alternateLocale} />
    <meta property="og:image" content={SOCIAL_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={SOCIAL_IMAGE} />
    <meta name="twitter:image:alt" content={social.imageAlt} />
    <link rel="preload" href="/fonts/LINESeedJP-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/cv-wordmark.svg" as="image" />
    <link rel="preload" href="/fonts/Joyride-Extended-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Extended-Outline.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-WIDE.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Outline-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{social.title}</title>
    <script is:inline>
      document.documentElement.classList.add("motion-enabled");
      if (location.pathname === "/" && location.hash) document.documentElement.dataset.sectionArrival = "";
      try { const arrival=JSON.parse(sessionStorage.getItem("portfolio-return") || "null"); if(location.pathname==="/" && !location.hash && arrival && Date.now()-arrival.time<10000) document.documentElement.dataset.routeArrival=""; } catch {}
    </script>
  </head>
  <body>
    <div class="cursor-glow" data-cursor-glow data-active="false" aria-hidden="true"></div>
    <slot />
  </body>
</html>
