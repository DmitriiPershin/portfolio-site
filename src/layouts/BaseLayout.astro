---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "ru" | "en";
  cvTheme?: "dark" | "light";
  cvView?: "desktop" | "mobile";
}

const { title, description, lang = Astro.locals.language || "en", cvTheme, cvView } = Astro.props;
---

<!doctype html>
<html lang={lang} data-cv-theme={cvTheme} data-cv-view={cvView}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={cvTheme === "light" ? "#f6f4ff" : "#000000"} />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/LINESeedJP-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/cv-wordmark.svg" as="image" />
    <link rel="preload" href="/fonts/Joyride-Extended-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Extended-Outline.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-WIDE.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Joyride-Outline-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%235946c9%22/><text x=%2250%22 y=%2264%22 font-size=%2246%22 text-anchor=%22middle%22 fill=%22white%22>DP</text></svg>" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("motion-enabled");
      if (location.pathname === "/" && location.hash) document.documentElement.dataset.sectionArrival = "";
      try { const arrival=JSON.parse(sessionStorage.getItem("portfolio-return") || "null"); if(location.pathname==="/" && !location.hash && arrival && Date.now()-arrival.time<10000) document.documentElement.dataset.routeArrival=""; } catch {}
    </script>
  </head>
  <body>
    <div class="cursor-glow" data-cursor-glow data-active="false" aria-hidden="true"></div>
    <slot />
  </body>
</html>
